# Desarrollo local. Para staging, leer docs/operacion.md. Guardar .env fuera de Git.
ALZACE_MODE=demo
FRONTEND_ORIGIN=http://127.0.0.1:3000
DEMO_SHORTCUTS=1
# Solo backend desplegado:
# DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
# SUPABASE_URL=https://PROYECTO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# ALZACE_KEYRING=
# Next.js lee API_INTERNAL_URL en el entorno del build y del servidor.
